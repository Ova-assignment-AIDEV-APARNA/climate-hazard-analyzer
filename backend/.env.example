# MongoDB Atlas connection string. Leave empty to use the in-memory store (dev only).
MONGO_URI=
MONGO_DB=climate_hazards

# Comma-separated browser origins allowed to call the API (your Vercel URL in production).
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the app (Render = 1). Used to read the real client IP.
TRUSTED_PROXY_HOPS=0

# Rate limits per client IP per minute.
RATE_LIMIT_PER_MINUTE=60
HEAVY_RATE_LIMIT_PER_MINUTE=12

# Identify yourself to OpenStreetMap Nominatim (their usage policy requires it).
NOMINATIM_USER_AGENT=climate-hazard-analyzer/1.0 (your-email@example.com)
